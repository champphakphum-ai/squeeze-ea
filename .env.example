# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  (ห้าม commit .env ขึ้น git)
# เฟสพิสูจน์แนวคิดไม่ต้องใช้คีย์ — ค่าพวกนี้ใช้ตอนเริ่มเทรด/เก็บข้อมูลต่อเนื่อง

# --- Deribit (สมัคร testnet ก่อน: https://test.deribit.com -> API) ---
DERIBIT_ENV=test                 # test | prod
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# --- MT5 (เฉพาะถ้าทำฝั่ง Gold/Oil/FX ภายหลัง) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
